{"is_source_file": true, "format": "bash script", "description": "A shell script that detects the type of the running database (SQLite, PostgreSQL, MySQL, MongoDB) and performs backups accordingly. It includes checks for database presence, versions, and authentication methods, and produces backup files based on the database type.", "external_files": ["/usr/lib/postgresql/", "/var/run/mysqld/mysqld.sock"], "external_methods": ["ls", "cp", "sudo -u postgres pg_isready", "ls", "mongosh", "mysqladmin", "mysql", "mysqldump"], "published": [], "classes": [], "methods": [], "calls": ["ls /usr/lib/postgresql/", "cp \"${DB_NAME}\" \"database_backup.db\"", "sudo -u postgres ${PG_BIN}/pg_isready -p ${DB_PORT}", "mongosh --port ${DB_PORT} --eval \"db.adminCommand('ping')\"", "mysqladmin ping -h localhost -P ${DB_PORT} --silent", "sudo mysqladmin ping --socket=/var/run/mysqld/mysqld.sock --silent", "mysql -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD}", "mysqldump -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD} --databases ${DB_NAME} --add-drop-database --routines --triggers --single-transaction", "mysql -h localhost -P ${DB_PORT} -u root -p${DB_PASSWORD}", "sudo mysql --socket=/var/run/mysqld/mysqld.sock -u root -p${DB_PASSWORD}", "sudo mysqldump --socket=/var/run/mysqld/mysqld.sock -u root -p${DB_PASSWORD}", "sudo mysql --socket=/var/run/mysqld/mysqld.sock -u root", "sudo mysqldump --socket=/var/run/mysqld/mysqld.sock -u root", "mongosh --port ${DB_PORT} --eval \"db.adminCommand('ping')\"", "mongodump --port ${DB_PORT} --db ${DB_NAME} --archive=database_backup.archive --quiet"], "search-terms": ["backup_db.sh", "database backup", "SQLite", "PostgreSQL", "MySQL", "mongosh", "pg_dump", "mysqldump", "mongodb backup", "database detection"], "state": 2, "file_id": 8, "knowledge_revision": 16, "git_revision": "d82856555e78d68011810ad7d77aa4dd3620b4e0", "hash": "7af9aa35fa4940f934d83f6e2621b732", "format-version": 4, "code-base-name": "RelationalDatabase", "filen